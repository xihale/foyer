# foyer 用户级 systemd 单元（foyer-ci 用户，linger 常驻）
# 由 scripts/server/deploy.sh 安装到 ~/.config/systemd/user/foyer.service
# 数据目录：%h/.local/state/foyer/data/（db + icons，部署不触碰）
[Unit]
Description=foyer - homepage panel + uptime monitor
After=network-online.target

[Service]
ExecStart=%h/.local/bin/foyer
WorkingDirectory=%h/.local/state/foyer
# 堆软上限防 GC 懒回收漂移；给足余量不卡性能（实测无限制会漂到 50MB+）
Environment=GOMEMLIMIT=32MiB
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
