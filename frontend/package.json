{
  "name": "foyer-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode ssr",
    "build.client": "vite build",
    "build.ssg": "vite build -c adapters/ssg/vite.config.ts && bun scripts/inline-css.mjs",
    "check": "tsc --noEmit",
    "preview": "vite build && vite preview",
    "build": "bun run build.client && bun run build.ssg"
  },
  "devDependencies": {
    "@qwik.dev/core": "^2.0.0-beta.42",
    "@qwik.dev/router": "^2.0.0-beta.42",
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.0"
  }
}
